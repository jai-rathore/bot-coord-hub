# Clerk (https://dashboard.clerk.com → API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Optional Clerk route URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Render Postgres (or local Postgres).
# On Render use the External Database URL for migrate/seed from outside the private network.
# Non-local hosts automatically use SSL (sslmode=require).
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# Next.js
PORT=3000
