# Clerk (https://dashboard.clerk.com → API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Optional Clerk route URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Render Postgres (or local Postgres).
# On Render use the External Database URL for migrate/seed from outside the private network.
# Non-local hosts automatically use SSL (sslmode=require).
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# Next.js
PORT=3000

# Agent API light rate limit (requests / minute / IP+key bucket)
AGENT_RATE_LIMIT_PER_MIN=60

# Required in production for account-wide discovery privacy budgets. Render
# wires this to an internal-only Key Value (Valkey) service.
REDIS_URL=

# Production kill switch. Keep false until migrations, Valkey, safety
# moderation, and post-deploy verification are complete.
ENABLE_EVENTS=true
ENABLE_DISCOVERY=false
# Two-step rollout: deploy resolver-capable code first, then enable this flag
# to publish v2 contracts and pause stale v1 enrollments for reapproval.
ENABLE_CANONICAL_LOCATIONS=false

# Server-side Geoapify key for canonical city/neighborhood typeahead. Never
# expose this value through a NEXT_PUBLIC_ variable.
GEOAPIFY_API_KEY=

# Required in production for hashing guest email/IP bindings.
GUEST_TOKEN_PEPPER=

# Long random secrets. Existing encrypted tokens depend on keeping the first stable.
PUBLIC_INVITE_SECRET=
TOKEN_ENCRYPTION_KEY=
OAUTH_STATE_SECRET=

# Intent triage worker (cron / Cursor Cloud). Required for POST /api/v1/intents/triage
TRIAGE_SECRET=

# Optional LLM assist for triage (heuristic always runs)
OPENAI_API_KEY=
# OPENAI_TRIAGE_MODEL=gpt-4o-mini
GROK_API_KEY=
# XAI_API_KEY=
# GROK_TRIAGE_MODEL=grok-2-latest

# --- Event notification email (Resend) ---
# Without RESEND_API_KEY the events cron queues rows and never sends.
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=
# Until honeymatcha.io is verified in Resend, use the onboarding sender.
# That address can only reach the Resend account owner. After DNS
# verification: HoneyMatcha <no-reply@honeymatcha.io>
EVENT_EMAIL_FROM=HoneyMatcha <onboarding@resend.dev>

# --- Event notification texts (Twilio) ---
# TWILIO_FROM_NUMBER is the feature flag. Leave it empty to hide Text
# in the UI and skip SMS in the outbox. Set it (E.164) after A2P 10DLC
# is approved, on both the web service and the events-tick cron.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Optional. Used for sending once the From number is set.
TWILIO_MESSAGING_SERVICE_SID=

# Comma-separated emails allowed to publish/reject requested task types.
INTENT_ADMIN_EMAILS=

# --- Google Calendar OAuth (schedule_meeting) ---
# MockCalendar is for local development only. Production fails closed unless
# a real calendar is connected. Never set ALLOW_MOCK_CALENDAR=true in production.
GOOGLE_CALENDAR_ENABLED=false
ALLOW_MOCK_CALENDAR=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to https://honeymatcha-web.onrender.com/api/google/callback
# Also supported: https://honeymatcha.io/api/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# Optional extra MCP OAuth redirect URIs (comma-separated). Claude, ChatGPT,
# Cursor loopback/cloud, and cursor:// callbacks are already allowed.
# MCP_OAUTH_REDIRECT_URIS=
# Optional extra browser origins allowed to call the MCP transport.
# MCP_ALLOWED_ORIGINS=

# OpenAI's plugin submission portal provides this exact domain-verification
# token. Leave unset until submission; the well-known route returns 404 then.
OPENAI_APPS_CHALLENGE=
